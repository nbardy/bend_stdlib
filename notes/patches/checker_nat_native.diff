--- a/bend2/bend.ts
+++ b/bend2/bend.ts
@@ -2913,6 +2913,50 @@ export function body_flatten(b: Body, vars: PVar[], fr: () => number): LTerm {
 // a rewrite demands its evidence and steps to its body on {==}, else
 // sticks as a value.
 
+// Base's Nat operations on two closed numbers are computed natively, as
+// the compiler does, instead of unfolding one Succ per unit. Only closed
+// arguments are forced: forcing a symbolic one caches its unfolded form,
+// and an induction over it then never ends (tests/proof/shift_left_mask).
+const NAT_OPS: Record<Name, (a: number, b: number) => number | "LT" | "EQ" | "GT"> = {
+  "Nat.add": (a, b) => a + b, "Nat.sub": (a, b) => Math.max(a - b, 0), "Nat.mul": (a, b) => a * b,
+  "Nat.min": (a, b) => Math.min(a, b), "Nat.max": (a, b) => Math.max(a, b),
+  "Nat.cmp": (a, b) => a < b ? "LT" : a === b ? "EQ" : "GT",
+};
+
+const CLOSED = new WeakMap<HTerm, boolean>();
+function closed(t: HTerm): boolean {
+  let r = CLOSED.get(t);
+  if (r === undefined) {
+    r = t.$ === "Ref" || t.$ === "Lit" || (t.$ === "Var" && t.v !== undefined && closed(t.v))
+      || (t.$ === "App" && closed(t.f) && closed(t.x)) || (t.$ === "Ctr" && t.x.every(closed));
+    CLOSED.set(t, r);
+  }
+  return r;
+}
+
+// the number a closed Nat term normalizes to: Succs over a literal or Zero
+function nat_of(book: Book, t: HTerm): number | null {
+  let k = 0;
+  for (t = term_wnf(book, t); t.$ === "Ctr" && t.k === "Succ"; t = term_wnf(book, t.x[0])) {
+    k += 1;
+  }
+  return t.$ === "Lit" && t.k === "Nat" ? t.v + k : t.$ === "Ctr" && t.k === "Zero" ? k : null;
+}
+
+// k applied to the two APP frames on top of frs, when k is in NAT_OPS
+function nat_fast(book: Book, k: Name, frs: Frame[], s?: Span): HTerm | null {
+  const op = NAT_OPS[k];
+  const x = frs[frs.length - 1] as Extract<Frame, { $: "APP" }>;
+  const y = frs[frs.length - 2] as Extract<Frame, { $: "APP" }>;
+  if (op === undefined || !closed(x.x) || !closed(y.x)) {
+    return null;
+  }
+  const a = nat_of(book, x.x);
+  const b = a === null ? null : nat_of(book, y.x);
+  const r = a === null || b === null ? null : op(a, b);
+  return typeof r === "string" ? Ctr(r, [], s) : r !== null && Number.isSafeInteger(r) ? Lit("Nat", r, s) : null;
+}
+
 export function term_wnf(book: Book, term: HTerm): HTerm {
   const frs: Frame[] = [];
   let tm: HTerm = term;
@@ -3010,6 +3054,8 @@ export function term_wnf(book: Book, term: HTerm): HTerm {
         if (run < tld.n || tld.v === null) {
           break focus;
         }
+        const nat = tld.b ? nat_fast(book, tm.k, frs, tm.s) : null;
+        if (nat !== null) { frs.length -= 2; tm = nat; continue main; }
         const rf: HTerm = tm;
         lhs = { t: () => rf, n: tld.n };
         tm = tld.v;
