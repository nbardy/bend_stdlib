+# Base's Nat operations on closed numbers compute as numbers, not one
+# Succ at a time; a symbolic argument still unfolds
+import Base
+
+law big:
+  {Nat.cmp(Nat.mul(3000n, 3000n), Nat.add(8999999n, Nat.sub(5n, 9n))) == GT{} : Cmp}
+
+def big():
+  {==}
+
+law min_max:
+  {Nat.add(Nat.min(70000n, 90000n), Nat.max(70000n, 90000n)) == 160000n : Nat}
+
+def min_max():
+  {==}
+
+law open:
+  for n: Nat
+  {Nat.add(2n, n) == 1n+Nat.add(1n, n) : Nat}
+
+def open(n):
+  {==}
+
+#|All terms check.
