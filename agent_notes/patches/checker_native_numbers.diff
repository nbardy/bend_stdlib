+  ["U32.not", { t: "u", s: [true], f: ([a]) => (~a) >>> 0 }],
+  ["U32.shl", { t: "u", s: [true], f: ([a]) => (a << 1) >>> 0 }],
+  ["U32.shr", { t: "u", s: [true], f: ([a]) => a >>> 1 }],
+  ["U32.is_zero", { t: "u", s: [true], f: ([a]) => bool(a === 0) }],
