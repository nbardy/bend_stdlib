+// used to be, and comparing symbolic terms can then blow up.
+const CLOSED: WeakMap<HTerm, boolean> = new WeakMap();
+
+function fast_closed(t: HTerm): boolean {
+  const got = CLOSED.get(t);
+  if (got !== undefined) {
+    return got;
+  }
+  let r: boolean;
+  switch (t.$) {
+    case "Var": r = t.v !== undefined && fast_closed(t.v); break;
+    case "Ann": r = fast_closed(t.x); break;
+    case "App": r = fast_closed(t.f) && fast_closed(t.x); break;
+    case "Ctr": r = t.x.every(fast_closed); break;
+    case "Ref": case "Lit": r = true; break;
